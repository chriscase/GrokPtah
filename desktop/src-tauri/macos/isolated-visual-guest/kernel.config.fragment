CONFIG_MODULES=n
CONFIG_INET=n
CONFIG_IPV6=n
CONFIG_VIRTIO_NET=n
CONFIG_NETFILTER=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BLUETOOTH=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_FS=n
CONFIG_EXT4_FS=n
CONFIG_FUSE_FS=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
