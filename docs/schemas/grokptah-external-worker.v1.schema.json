{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grokptah:schema:external-worker:v1",
  "title": "GrokPtah External Worker Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "launchRequest", "worker", "run"],
  "properties": {
    "contract": { "const": "grokptah.external-workers.v1" },
    "launchRequest": { "$ref": "#/$defs/launchRequest" },
    "worker": { "$ref": "#/$defs/worker" },
    "run": { "$ref": "#/$defs/run" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "admission": { "$ref": "#/$defs/admission" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "capabilityStatus": { "type": "array", "items": { "$ref": "#/$defs/capabilityStatus" } }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "comment": "A workspace or principal alias. Never an absolute path, a drive-qualified path, a UNC path, or a traversal.",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000-\\u001f\\r\\n]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "comment": "Bounded redacted operator text. Never provider output, a URL, a credential, or a host path.",
      "pattern": "^[^\\u0000-\\u001f\\r\\n]+$"
    },
    "mutation": { "enum": ["launch", "follow_up", "cancel"] },
    "receiptState": { "enum": ["claimed", "accepted", "rejected", "uncertain"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "sessionId", "workspace", "runId"],
      "properties": {
        "principalId": { "$ref": "#/$defs/identity" },
        "sessionId": { "$ref": "#/$defs/identity" },
        "workspace": { "$ref": "#/$defs/alias" },
        "runId": { "$ref": "#/$defs/identity" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalAgentId"],
      "properties": {
        "externalAgentId": { "$ref": "#/$defs/identity" },
        "externalRunId": { "$ref": "#/$defs/identity" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "comment": "A host-minted, single-use, scope-bound ticket. It is not a bearer credential: the host revalidates every field against its own mint ledger.",
      "required": [
        "contract", "admissionId", "nonce", "requestId", "scope", "mutation", "provider",
        "capabilityRevision", "issuedAtMs", "expiresAtMs", "payloadDigest"
      ],
      "properties": {
        "contract": { "const": "grokptah.external-workers.v1" },
        "admissionId": { "$ref": "#/$defs/identity" },
        "nonce": { "$ref": "#/$defs/identity" },
        "requestId": { "$ref": "#/$defs/identity" },
        "scope": { "$ref": "#/$defs/scope" },
        "mutation": { "$ref": "#/$defs/mutation" },
        "provider": { "$ref": "#/$defs/provider" },
        "providerId": { "$ref": "#/$defs/identity" },
        "capabilityRevision": { "type": "integer", "minimum": 0 },
        "issuedAtMs": { "type": "integer", "minimum": 0 },
        "expiresAtMs": { "type": "integer", "minimum": 0 },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "comment": "Durable redacted evidence of one mutation attempt. Carries opaque identities and a payload digest only.",
      "required": [
        "contract", "requestId", "admissionId", "mutation", "scope", "provider",
        "providerRequestId", "attempt", "state", "payloadDigest", "reason",
        "createdAtMs", "updatedAtMs"
      ],
      "properties": {
        "contract": { "const": "grokptah.external-workers.v1" },
        "requestId": { "$ref": "#/$defs/identity" },
        "admissionId": { "$ref": "#/$defs/identity" },
        "mutation": { "$ref": "#/$defs/mutation" },
        "scope": { "$ref": "#/$defs/scope" },
        "provider": { "$ref": "#/$defs/provider" },
        "providerId": { "$ref": "#/$defs/identity" },
        "providerRequestId": { "$ref": "#/$defs/identity" },
        "attempt": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/receiptState" },
        "target": { "$ref": "#/$defs/target" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "reason": { "$ref": "#/$defs/reason" },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilityStatus": {
      "type": "object",
      "additionalProperties": false,
      "comment": "All four gates must hold before a host advertises an external-worker capability.",
      "required": [
        "provider", "registered", "reachable", "versionCompatible", "policyAllowed",
        "capabilityRevision"
      ],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "providerId": { "$ref": "#/$defs/identity" },
        "registered": { "type": "boolean" },
        "reachable": { "type": "boolean" },
        "versionCompatible": { "type": "boolean" },
        "policyAllowed": { "type": "boolean" },
        "capabilityRevision": { "type": "integer", "minimum": 0 },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "provider": {
      "enum": ["cursor_cloud", "claude_code_cloud", "local_worker", "custom"]
    },
    "state": {
      "enum": ["provisioning", "ready", "running", "completed", "failed", "cancelled", "archived", "unknown"]
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\r\\n]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\][^\\u0000-\\u001f\\r\\n]*$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPromptBytes": { "type": "integer", "minimum": 1 },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 24 },
        "maxDurationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "launchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "provider", "repository", "startingRef", "prompt", "executionMode", "autoCreatePr"],
      "properties": {
        "requestId": { "$ref": "#/$defs/identity" },
        "provider": { "$ref": "#/$defs/provider" },
        "providerId": { "$ref": "#/$defs/identity" },
        "repository": { "$ref": "#/$defs/ref" },
        "startingRef": { "$ref": "#/$defs/ref" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "model": { "$ref": "#/$defs/identity" },
        "executionMode": { "const": "isolated" },
        "autoCreatePr": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "externalAgentId", "repository", "startingRef", "state", "createdAt", "updatedAt"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "providerId": { "$ref": "#/$defs/identity" },
        "externalAgentId": { "$ref": "#/$defs/identity" },
        "repository": { "$ref": "#/$defs/ref" },
        "startingRef": { "$ref": "#/$defs/ref" },
        "state": { "$ref": "#/$defs/state" },
        "branch": { "$ref": "#/$defs/ref" },
        "workerUrl": { "type": "string", "maxLength": 512, "pattern": "^https://" },
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalAgentId", "externalRunId", "state", "lastSeq", "createdAt", "updatedAt"],
      "properties": {
        "externalAgentId": { "$ref": "#/$defs/identity" },
        "externalRunId": { "$ref": "#/$defs/identity" },
        "state": { "$ref": "#/$defs/state" },
        "lastSeq": { "type": "integer", "minimum": 0 },
        "terminalResult": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "ts", "kind", "detail"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "ts": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detail": { "type": "string", "maxLength": 4096 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/ref" },
        "digest": { "$ref": "#/$defs/identity" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
