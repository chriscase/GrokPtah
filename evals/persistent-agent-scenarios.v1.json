{
  "schema": "grokptah.persistent_agent_scenarios.v1",
  "catalog_id": "persistent-agent-certification-v1",
  "catalog_version": 1,
  "contract_document": "docs/PERSISTENT_AGENT_CERTIFICATION.md",
  "assertion_policy": {
    "exact_prose_assertions": false,
    "live_assertions": [
      "protocol_shape",
      "typed_outcome",
      "durable_state",
      "authoritative_usage",
      "bounded_resources",
      "synthetic_workspace_oracle"
    ]
  },
  "provider_phases": [
    {
      "id": "native-xai-grok-build-oidc",
      "order": 1,
      "route_class": "grok_build_proxy",
      "credential_class": "grok_build_oidc",
      "default_evidence_mode": "synthetic_payloads",
      "fixture_promotion": "human_review_required"
    },
    {
      "id": "provider-neutral-corporate-gateway",
      "order": 2,
      "route_class": "compatible_corporate_gateway",
      "credential_class": "externally_managed",
      "default_evidence_mode": "metadata_only",
      "fixture_promotion": "forbidden_unless_independently_synthetic_and_human_approved"
    }
  ],
  "artifact_policy": {
    "raw_root": "evals/runs/persistent-agent-cert",
    "raw_git_policy": "ignored",
    "versioned_fixture_root": "evals/provider-contracts/xai/v1",
    "fixture_git_policy": "sanitized_reviewed",
    "fixture_promotion": {
      "automatic": false,
      "human_review_required": true,
      "promotion_manifest_required": true,
      "secret_scan_required": true,
      "positive_allowlist_required": true
    },
    "forbidden_data_classes": [
      "authorization_headers",
      "api_keys",
      "access_refresh_or_id_tokens",
      "cookies_or_signing_material",
      "grok_auth_file_contents",
      "oidc_user_team_principal_or_account_values",
      "arbitrary_request_or_response_headers",
      "unfiltered_environment_or_process_arguments",
      "personal_or_corporate_source_content",
      "personal_or_corporate_prompts_or_completions",
      "private_memory_terminal_clipboard_or_computer_use_content",
      "private_or_corporate_endpoints_and_routing_metadata",
      "private_error_bodies",
      "real_home_workspace_or_repository_paths",
      "machine_or_user_identifiers",
      "embeddings_vectors_or_opaque_binary_payloads"
    ]
  },
  "bound_profiles": {
    "smoke": {
      "per_run_token_ceiling": 20000,
      "campaign_token_ceiling": 100000,
      "provider_request_ceiling": 40,
      "continuation_ceiling": 4,
      "duration_seconds": 1800,
      "raw_artifact_byte_ceiling": 134217728,
      "response_byte_ceiling_per_request": 8388608,
      "missing_usage_policy": "fail_closed"
    },
    "standard": {
      "per_run_token_ceiling": 100000,
      "campaign_token_ceiling": 500000,
      "provider_request_ceiling": 160,
      "continuation_ceiling": 16,
      "duration_seconds": 7200,
      "raw_artifact_byte_ceiling": 536870912,
      "response_byte_ceiling_per_request": 16777216,
      "missing_usage_policy": "fail_closed"
    },
    "extended": {
      "per_run_token_ceiling": 250000,
      "campaign_token_ceiling": 2000000,
      "provider_request_ceiling": 800,
      "continuation_ceiling": 96,
      "duration_seconds": 86400,
      "raw_artifact_byte_ceiling": 2147483648,
      "response_byte_ceiling_per_request": 33554432,
      "missing_usage_policy": "fail_closed"
    }
  },
  "lifecycle_contract": {
    "agent_lifetime": "months_or_years",
    "lane_lifetime": "frequently_archived_work_context",
    "run_lifetime": "finite_and_bounded",
    "long_operation_model": "sequence_of_checkpointed_finite_runs",
    "lane_archive_effect": "preserve_agent_memory_runs_checkpoints_and_associations",
    "agent_retirement_equivalent_to_lane_archive": false
