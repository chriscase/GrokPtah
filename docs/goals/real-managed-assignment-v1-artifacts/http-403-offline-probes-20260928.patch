--- a/crates/codegen/grokptah-agent-bridge/src/auth_store.rs
+++ b/crates/codegen/grokptah-agent-bridge/src/auth_store.rs
@@ -51,0 +52,69 @@ pub(crate) fn xai_keychain_api_key_state() -> crate::live_attestation::KeychainA
+#[cfg(test)]
+mod http_403_parity_probe {
+    #[test]
+    fn synthetic_managed_oidc_request_builds_expected_headers_without_sending() {
+        let credentials = super::WireCredentials {
+            provider_id: "xai".into(),
+            bearer: "synthetic-credential-never-sent".into(),
+            oidc_token_auth: true,
+            display_name: "synthetic".into(),
+            method: "grok_build:oidc".into(),
+            user_id: Some("synthetic-user".into()),
+            team_id: None,
+            auth_scope: None,
+            refresh_token: None,
+            oidc_issuer: None,
+            oidc_client_id: None,
+            principal_type: None,
+            principal_id: None,
+            expires_at: None,
+        };
+        let base = "https://cli-chat-proxy.grok.com/v1";
+        let client = reqwest::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .unwrap();
+        let request = super::apply_auth_headers(
+            client
+                .post(format!("{base}/chat/completions"))
+                .header("Content-Type", "application/json")
+                .header("Accept", "text/event-stream")
+                .header("x-grok-effort", "low"),
+            &credentials,
+            base,
+        )
+        .json(&serde_json::json!({
+            "model": "grok-build-0.1",
+            "messages": [{"role":"user","content":"synthetic"}],
+            "tools": [],
+            "stream": true,
+            "stream_options": {"include_usage":true},
+            "max_tokens": 1024,
+            "parallel_tool_calls": false
+        }))
+        .build()
+        .unwrap();
+        assert_eq!(request.method(), reqwest::Method::POST);
+        assert_eq!(request.url().as_str(), "https://cli-chat-proxy.grok.com/v1/chat/completions");
+        let h = request.headers();
+        let get = |name: &str| h.get(name).and_then(|v| v.to_str().ok());
+        assert_eq!(get("x-grok-client-version"), Some("1.0.41"));
+        assert_eq!(get("x-grok-client-mode"), Some("interactive"));
+        assert_eq!(get("X-XAI-Token-Auth"), Some("xai-grok-cli"));
+        assert_eq!(get("x-authenticateresponse"), Some("authenticate-response"));
+        assert_eq!(get("x-userid"), Some("synthetic-user"));
+        assert_eq!(get("x-grok-effort"), Some("low"));
+        assert!(get("authorization").is_some_and(|v| v.starts_with("Bearer synthetic-")));
+        assert!(get("x-grok-client-identifier").is_none());
+        assert!(get("x-grok-model-override").is_none());
+        assert!(get("x-grok-conv-id").is_none());
+        assert!(get("x-grok-req-id").is_none());
+        assert!(get("x-grok-session-id").is_none());
+        let body: serde_json::Value =
+            serde_json::from_slice(request.body().unwrap().as_bytes().unwrap()).unwrap();
+        assert_eq!(body["model"], "grok-build-0.1");
+        assert_eq!(body["stream_options"]["include_usage"], true);
+        println!("offline request build: method=POST path=/v1/chat/completions version=1.0.41 client-mode=interactive token-auth=present authenticate-response=present model-override=absent client-identifier=absent tracking-ids=absent body-model=grok-build-0.1 include-usage=true; sends=0");
+    }
+}
