{
  "name": "@grokptah/client",
  "version": "0.1.0",
  "description": "Browser-safe GrokPtah broker client and headless UI primitives",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/public.d.ts",
      "import": "./grokptah-public.js"
    },
    "./ui-core": {
      "types": "./types/uiCore.d.ts",
      "import": "./ui-core.js"
    },
    "./host": {
      "browser": null,
      "worker": null,
      "types": "./types/host.d.ts",
      "import": "./grokptah-host.js",
      "default": null
    }
  },
  "files": [
    "grokptah-public.js",
    "ui-core.js",
    "grokptah-host.js",
    "types"
  ]
}
