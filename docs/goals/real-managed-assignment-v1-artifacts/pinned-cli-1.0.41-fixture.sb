(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow file-read-metadata (literal "/") (literal "/private") (literal "/private/tmp")
  (literal "/opt") (literal "/System") (literal "/usr") (literal "/bin")
  (literal "/Applications") (literal "/Library"))
(allow file-read* (subpath (param "ROOT"))
  (subpath "/System/Library") (subpath "/System/Cryptexes")
  (subpath "/usr/lib") (subpath "/usr/share")
  (subpath "/usr/bin") (subpath "/bin")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath "/opt/homebrew")
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random")
  (literal "/private/etc/localtime") (literal "/private/var/db/timezone/localtime"))
(allow file-write* (subpath (param "ROOT")) (literal "/dev/null"))
(allow network-inbound (local ip "localhost:49173"))
