{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grokptah:schema:cu-eval-evidence-set:v1",
  "title": "GrokPtah Computer Use adaptive evaluation evidence set v1",
  "description": "Array of redacted episode evidence bound to one campaign digest. Replaces a bare JSON array emission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignDigest", "items"],
  "properties": {
    "schemaVersion": { "const": "grokptah.cu_eval_evidence_set.v1" },
    "campaignDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:grokptah:schema:cu-eval-evidence:v1" }
    }
  }
}
