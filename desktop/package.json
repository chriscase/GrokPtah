{
  "name": "grokptah-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:public": "tsc -p tsconfig.lib.json && vite build --config vite.library.config.ts && node scripts/stage-public-package.mjs",
    "dev": "vite",
    "help:build-model": "node --import ./scripts/register-ts-hook.mjs scripts/build-help-model.mjs",
    "help:eval": "node --import ./scripts/register-ts-hook.mjs scripts/run-help-eval.mjs",
    "help:verify": "npm run help:verify-corpus && npm run help:verify-source-bytes && npm run help:verify-model && npm run help:eval",
    "help:verify-corpus": "node --import ./scripts/register-ts-hook.mjs scripts/verify-help-corpus.mjs",
    "help:verify-source-bytes": "node --import ./scripts/register-ts-hook.mjs scripts/verify-help-source-bytes.mjs",
    "help:verify-model": "node --import ./scripts/register-ts-hook.mjs scripts/verify-help-model.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:public": "npm run build:public && node scripts/verify-public.mjs && node scripts/run-public-consumer-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
