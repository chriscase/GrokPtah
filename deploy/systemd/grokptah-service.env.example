# Copy to /etc/grokptah/grokptah-service.env and chmod 600.
# Keep the token out of the unit file and process arguments.
GROKPTAH_HOME=/var/lib/grokptah
GROKPTAH_SERVICE_LISTEN=127.0.0.1:39200
GROKPTAH_SERVICE_TOKEN=replace-with-a-random-token-at-least-24-characters
GROKPTAH_SERVICE_WORKSPACES=/srv/grokptah/workspace
GROKPTAH_SERVICE_MAX_CONCURRENT=4
GROKPTAH_SERVICE_REQUEST_TIMEOUT_MS=120000
